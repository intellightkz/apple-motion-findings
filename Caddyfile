{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	# Fills {{env "OWNER_NAME"}} / {{env "OWNER_ID"}} placeholders in index.html on every request
	templates {
		mime text/html
	}
	header / Cache-Control "no-cache"
	header /index.html Cache-Control "no-cache"
	header /photo.jpg Cache-Control "no-cache"
	header /glass-pay-* Cache-Control "public, max-age=3600"
	file_server
}
